{
  "name": "@azmr/pr-quality-checks",
  "version": "0.2.0",
  "description": "Shared PR quality/security check scripts for azmara-labs repos",
  "type": "module",
  "license": "MIT",
  "author": "Alshafaraz Gazi <alshafaraz.gazi@gmail.com>",
  "homepage": "https://github.com/azmara-labs/pr-quality-checks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azmara-labs/pr-quality-checks.git"
  },
  "keywords": ["ci", "lint", "package-hygiene", "npm-publish", "azmara"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["scripts", "README.md", "LICENSE"],
  "bin": {
    "pr-quality-checks": "scripts/run-all.mjs"
  },
  "scripts": {
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:package-metadata": "node scripts/check-package-metadata.mjs",
    "check:files-consistency": "node scripts/check-files-consistency.mjs",
    "check:publish-guard": "node scripts/check-publish-guard.mjs",
    "check:config-schema": "node scripts/check-config-schema.mjs",
    "check:all": "node scripts/run-all.mjs"
  }
}
